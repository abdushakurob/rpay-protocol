{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps && npm install --prefix apps/merchant --legacy-peer-deps",
  "framework": "vite",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "merchant.rpay.space" }],
      "dest": "/merchant/app/index.html"
    },
    { "handle": "filesystem" },
    { "src": "^/merchant/app/?$", "dest": "/merchant/app/index.html" },
    { "src": "^/merchant/app/.*$", "dest": "/merchant/app/index.html" },
    { "src": "^/((?!api/).*)$", "dest": "/index.html" }
  ]
}
