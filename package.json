{
  "name": "rpay-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:wallet": "vite",
    "dev:merchant": "npm run dev --prefix apps/merchant",
    "build": "npm run build:site && npm run build:merchant:embedded",
    "build:site": "tsc --noEmit && vite build",
    "build:merchant": "npm run build --prefix apps/merchant",
    "build:merchant:embedded": "npm run build --prefix apps/merchant -- --base=/merchant/app/ --outDir=../../dist/merchant/app --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "devnet": "node scripts/devnet-session.mjs",
    "send-devnet": "node scripts/send-devnet.mjs",
    "usdt:devnet": "node scripts/create-devnet-usdt.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@rpay/protocol": "0.1.0-draft.0",
    "@scure/bip39": "^1.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/transactions": "^3.0.3",
    "@solana/web3.js": "^1.98.4",
    "@tetherto/wdk-wallet-solana": "^1.0.0-beta.21",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "highlight.js": "^11.12.0",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sodium-javascript": "^0.8.0",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "ed25519-hd-key": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  }
}
